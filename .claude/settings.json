{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-ufffd.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for U+FFFD"
          }
        ]
      }
    ]
  }
}
